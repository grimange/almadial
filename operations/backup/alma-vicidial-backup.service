[Unit]
Description=Idle-window VICIdial consistent database and recovery-file backup
After=mariadb.service asterisk.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/alma-vicidial-backup backup
TimeoutStartSec=15min
TimeoutStopSec=10s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
