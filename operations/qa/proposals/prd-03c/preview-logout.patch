+// PRD-03C proposal: release only an unfinished list preview, then normal logout.
+// Keep the phone/session alive on failure. Retrying a lost acknowledgement is safe.
+var preview_logout_pending = false;
+var native_logout_pending = false;
+function NativeLogoutResponseOK(text)
+	{
+	var fields = text.trim().split('|');
+	return fields.length == 6 && /^[0-9]+$/.test(fields[0]) &&
+		/^[0-9]*$/.test(fields[1]) && /^[0-9]+$/.test(fields[2]) &&
+		/^[0-9]+$/.test(fields[3]) && /^[0-9]+$/.test(fields[5]);
+	}
+function ReleasePreviewForLogout(reason, pause, trigger)
+	{
+	if (preview_logout_pending) {return;}
+	if ((manual_dial_in_progress == 1) || (MD_channel_look == 1) ||
+		(VD_live_customer_call == 1) || (alt_dial_status_display == 1))
+		{alert_box("Finish the current dial or call before logging out."); return;}
+	preview_logout_pending = true;
+	var request = new XMLHttpRequest();
+	var completed = false;
+	function fail()
+		{
+		if (completed) {return;}
+		completed = true;
+		preview_logout_pending = false;
+		alert_box("Preview release was not confirmed. You are still logged in. Retry LOGOUT or contact your administrator; do not close the browser.");
+		}
+	request.open('POST', 'vdc_db_query.php');
+	request.timeout = 15000;
+	request.setRequestHeader('Content-Type','application/x-www-form-urlencoded; charset=UTF-8');
+	request.onerror = fail;
+	request.ontimeout = fail;
+	request.onabort = fail;
+	request.onreadystatechange = function()
+		{
+		if (request.readyState != 4 || completed) {return;}
+		if (request.status != 200 || request.responseText.trim() != 'PREVIEW RELEASED')
+			{fail(); return;}
+		completed = true;
+		preview_logout_pending = false;
+		in_lead_preview_state = 0;
+		document.vicidial_form.lead_id.value = '';
+		previous_dispo = '';
+		previous_called_count = '';
+		LogouT(reason, pause, trigger);
+		};
+	var fields = {server_ip:server_ip, session_name:session_name, ACTION:'manDiaLskip',
+		format:'logout-preview', conf_exten:session_id, user:user, pass:pass,
+		lead_id:document.vicidial_form.lead_id.value, stage:previous_dispo,
+		called_count:previous_called_count, campaign:campaign};
+	var body = Object.keys(fields).map(function(key)
+		{return encodeURIComponent(key) + '=' + encodeURIComponent(fields[key]);}).join('&');
+	try {request.send(body);} catch (error) {fail();}
+	}
+// End PRD-03C proposal helper.
