+// PRD-03C proposal: serialize claim/dial/release/logout for one native user.
+// GET_LOCK is connection-scoped; MyISAM does not support rollback transactions.
+if (in_array($ACTION, array('manDiaLnextCaLL','manDiaLonly','manDiaLskip','userLOGout'), true))
+	{
+	$preview_lock_name = 'vici-preview-' . md5($user);
+	$preview_lock_result = mysql_to_mysqli("SELECT GET_LOCK('$preview_lock_name',3)", $link);
+	$preview_lock_row = $preview_lock_result ? mysqli_fetch_row($preview_lock_result) : false;
+	if (!$preview_lock_row || $preview_lock_row[0] != 1) {exit("PREVIEW BUSY\n");}
+	register_shutdown_function(function() use ($link, $preview_lock_name)
+		{mysqli_query($link,"DO RELEASE_LOCK('$preview_lock_name')");});
+	// Native authentication occurred before waiting: reject an expired queued request.
+	$preview_session = mysql_to_mysqli("SELECT 1 FROM web_client_sessions WHERE session_name='$session_name' AND server_ip='$server_ip' LIMIT 1",$link);
+	if (!$preview_session || mysqli_num_rows($preview_session) != 1) {exit("PREVIEW SESSION EXPIRED\n");}
+	// A DIAL queued before release must still own the preview after the lock.
+	if (($ACTION == 'manDiaLonly') && ($format == 'preview-call'))
+		{
+		$preview_check = mysql_to_mysqli("SELECT 1 FROM vicidial_live_agents WHERE user='$user' AND server_ip='$server_ip' AND conf_exten='$conf_exten' AND campaign_id='$campaign' AND preview_lead_id='$lead_id' AND lead_id=0 AND status IN('PAUSED','READY')",$link);
+		if (!$preview_check || mysqli_num_rows($preview_check) != 1) {exit("CALL NOT PLACED\n");}
+		}
+	// Never discard an outstanding claim if the release request failed or was lost.
+	if ($ACTION == 'userLOGout')
+		{
+		$preview_check = mysql_to_mysqli("SELECT preview_lead_id FROM vicidial_live_agents WHERE user='$user' AND server_ip='$server_ip' AND conf_exten='$conf_exten' AND campaign_id='$campaign'",$link);
+		if (!$preview_check) {exit("PREVIEW NOT RELEASED\n");}
+		while ($preview_row = mysqli_fetch_row($preview_check))
+			{if ($preview_row[0] > 0) {exit("PREVIEW NOT RELEASED\n");}}
+		}
+	}
+// End PRD-03C serialization.
